#!/bin/bash
# Guard: keep data out of the repository history (docs/DESIGN.md, decision D8).
# Deliberate, maintainer-approved exception: GENVAL_ALLOW_DATA=1 git commit ...
[ "$GENVAL_ALLOW_DATA" = "1" ] && exit 0

fail=0
while IFS= read -r -d '' f; do
    case "$f" in
        uv.lock)  # lockfile: exempt from the size guard
            continue
            ;;
        *_ss.txt|*ss-merged*|*_tx_*|*transactions*|*past-answers*|*.npy|*.pt|*.ckpt|*.qsf)
            echo "BLOCKED (data-like name): $f" >&2
            fail=1
            continue
            ;;
    esac
    if [ -f "$f" ] && [ "$(wc -c <"$f")" -gt 512000 ]; then
        echo "BLOCKED (>500 KB): $f" >&2
        fail=1
    fi
done < <(git diff --cached --name-only --diff-filter=AM -z)

if [ "$fail" -eq 1 ]; then
    echo "Data must not enter the repository history. See docs/DESIGN.md (D8)." >&2
    echo "For a deliberate, approved exception: GENVAL_ALLOW_DATA=1 git commit ..." >&2
    exit 1
fi
